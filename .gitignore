# Plus d'infos : https://docs.github.com/fr/get-started/getting-started-with-git/ignoring-files

# ---------- Dépendances ----------
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ---------- Tests (Jest) ----------
/coverage

# ---------- Next.js ----------
/.next/
/out/

# ---------- Production ----------
/build

# ---------- Variables d'environnement ----------
# (URL du backend, clés, secrets…) — garder seulement un éventuel .env.example
.env
.env*.local
.env.development
.env.production
!.env.example

# ---------- Logs / debug ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Caches ----------
.eslintcache
*.tsbuildinfo

# ---------- Fichiers système ----------
.DS_Store
Thumbs.db

# ---------- Éditeurs / IDE ----------
.vscode/
.idea/
*.swp

# ---------- Divers ----------
*.pem

# ---------- Vercel ----------
.vercel
